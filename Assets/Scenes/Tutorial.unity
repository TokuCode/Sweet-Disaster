      data:
        <Name>k__BackingField: Home Broadband with Congested Network
        <Description>k__BackingField: Desktop and console platforms trough congested
          networks (multiple downloads or streaming already using the network's maximum
          capacity). Medium ping, bad jitter and little packet loss.
        <PacketDelayMs>k__BackingField: 50
        <PacketJitterMs>k__BackingField: 50
        <PacketLossInterval>k__BackingField: 0
        <PacketLossPercent>k__BackingField: 1
